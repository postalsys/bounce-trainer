{
  "name": "bounce-trainer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Web interface for crowdsourcing SMTP bounce classification training data",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test test/*.test.js",
    "format": "prettier --write ."
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@postalsys/bounce-classifier": "3.0.1",
    "better-sqlite3": "13.0.3",
    "bootstrap": "5.3.8",
    "bootstrap-icons": "1.13.1",
    "connect-sqlite3": "0.9.18",
    "ejs": "6.0.1",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "express-session": "1.19.0",
    "helmet": "8.3.0",
    "passport": "0.7.0",
    "passport-github2": "0.1.12"
  },
  "devDependencies": {
    "prettier": "3.9.9"
  },
  "allowScripts": {
    "sqlite3": true,
    "better-sqlite3": false
  },
  "overrides": {
    "sqlite3": "6.0.1"
  }
}
